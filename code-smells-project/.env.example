# Copie para .env (ou exporte no shell) e preencha. Nenhum valor real deve ser commitado.

# Chave para assinatura de sessões/cookies. Sem ela, uma chave aleatória é gerada a cada boot.
SECRET_KEY=

# Token exigido no header X-Admin-Token por /admin/reset-db, /admin/query e /relatorios/vendas.
# Sem ele, esses endpoints respondem 403 (desabilitados).
ADMIN_TOKEN=

# Modo debug do Flask (nunca habilite em produção). Default: false
FLASK_DEBUG=false

# Endereço e porta do servidor. Default: 127.0.0.1:5000 (use 0.0.0.0 para expor na rede)
HOST=127.0.0.1
PORT=5000

# Caminho do arquivo SQLite. Default: loja.db
DATABASE_PATH=loja.db

# Origens permitidas no CORS, separadas por vírgula. Default: *
CORS_ORIGINS=*

# Nome do ambiente exibido no /health. Default: producao
APP_ENV=producao

# Nível de log (DEBUG, INFO, WARNING, ERROR). Default: INFO
LOG_LEVEL=INFO
