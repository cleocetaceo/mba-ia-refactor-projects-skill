# Copie para .env (ou exporte no shell) e ajuste os valores. Nunca versione valores reais.

# Chave de assinatura do Flask. Sem valor, uma chave aleatória é gerada a cada boot.
SECRET_KEY=

# Token exigido no header X-Admin-Token por /admin/reset-db, /admin/query e /relatorios/vendas.
# Sem valor, esses endpoints ficam desabilitados (403).
ADMIN_TOKEN=

# Debug do Flask/Werkzeug. Nunca habilite em produção.
FLASK_DEBUG=false

# Endereço e porta do servidor. Use HOST=0.0.0.0 para expor na rede.
HOST=127.0.0.1
PORT=5000

# Caminho do arquivo SQLite (criado e populado no primeiro boot).
DATABASE_PATH=loja.db

# Nome do ambiente exibido em /health.
APP_ENV=producao

# Origens permitidas pelo CORS: "*" ou lista separada por vírgula (ex.: https://loja.exemplo.com).
CORS_ORIGINS=*

# Nível de log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
