# Copie para .env e ajuste. Nenhum valor real deve ser versionado.

# Chave de assinatura (sessões/tokens). Sem valor, uma chave aleatória é gerada a cada boot.
SECRET_KEY=

# Banco de dados (SQLAlchemy). O caminho relativo do SQLite fica em instance/.
DATABASE_URL=sqlite:///tasks.db

# Servidor
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# Origens liberadas no CORS: "*" ou lista separada por vírgula (ex.: https://app.exemplo.com)
CORS_ORIGINS=*

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Token exigido no header X-Admin-Token em PUT/DELETE /users/<id> e para definir "role" no POST /users.
# Sem valor, esses endpoints/campos administrativos ficam desabilitados.
ADMIN_TOKEN=

# Tamanho mínimo de senha em POST/PUT /users. O default do código é 8; não use 4.
MIN_PASSWORD_LENGTH=8
