# Copie para .env (carregado automaticamente no boot) ou exporte as variáveis no shell.
# Nunca versione valores reais.

# Porta HTTP (default: 3000)
PORT=3000

# Interface de escuta (vazio = todas as interfaces, como no código original)
HOST=

# Caminho do banco SQLite (default: :memory:, banco volátil recriado a cada boot)
DATABASE_PATH=:memory:

# Chave do gateway de pagamento (o gateway atual é simulado; vazio gera apenas um aviso no boot)
PAYMENT_GATEWAY_KEY=

# Token exigido no header X-Admin-Token pelos endpoints administrativos
# (GET /api/admin/financial-report e DELETE /api/users/:id). Vazio = endpoints desabilitados (403).
ADMIN_TOKEN=
